# Highness Configuration
# Copy to .env and fill in your values

# Required: Ollama Cloud API key
# Create one at https://ollama.com/settings/keys
OLLAMA_API_KEY=your_key_here

# Optional: model override (default: gpt-oss:120b)
# Direct cloud requests use the identifiers from https://ollama.com/api/tags
# e.g. gpt-oss:120b, gpt-oss:20b, qwen3-coder:480b, kimi-k2.6, glm-5.3
OLLAMA_MODEL=gpt-oss:120b